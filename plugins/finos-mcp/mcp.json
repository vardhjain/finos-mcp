{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "finos-aigf": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "--no-config",
        "run",
        "--project",
        "${PLUGIN_ROOT}",
        "--frozen",
        "--default-index",
        "https://pypi.org/simple",
        "--python",
        "3.12",
        "finos-mcp-aigf"
      ]
    },
    "finos-cdm": {
      "type": "stdio",
