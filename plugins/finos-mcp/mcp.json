        "--default-index",
        "https://pypi.org/simple",
        "--python",
        "3.12",
        "finos-mcp-cdm"
      ]
    },
    "finos-fdc3": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "--no-config",
        "run",
        "--project",
        "${PLUGIN_ROOT}",
        "--frozen",
        "--default-index",
        "https://pypi.org/simple",
        "--python",
        "3.12",
        "finos-mcp-fdc3"
      ]
    }
  }
}
